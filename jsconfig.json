{
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "paths": {
            "@/*": ["resources/js/*"]
        },
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "resources/js/**/*"
    ]
}

